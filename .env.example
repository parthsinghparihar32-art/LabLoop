# LabLoop Environment Variables
# Copy this file to .env.local and populate with your Supabase credentials

# Supabase Public Configuration (accessible in client & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret (NEVER expose to browser/client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
